# ---------------------------------------------------------------------------
# Copy to .env.local for local development, and set the same values in Vercel.
#
# The app runs with NONE of these set: it falls back to an embedded PGlite
# database and logs notifications instead of sending them. That is deliberate,
# and it is what lets the whole thing run for free.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Leave EMPTY locally to use the embedded PGlite store under .data/pglite.
#
# In production, set this to a Neon connection string. Installing Neon from the
# Vercel Marketplace injects it for you.
#
# Neon specifically, not Supabase: Supabase's free tier PAUSES a project after a
# week of inactivity and needs a manual restore. That is exactly the wedding
# failure pattern - build in September, collect replies in October, go quiet in
# November, and discover in December that the site is down because a guest told
# you. Neon scale-to-zeros after five minutes and auto-resumes on the next
# query, so the worst case is a sub-second cold start.
DATABASE_URL=

# --- Admin ----------------------------------------------------------------
# REQUIRED before /admin will do anything. Generate ADMIN_SECRET with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
#
# Use a long random ADMIN_PASSWORD. There is one shared credential and no MFA,
# which is proportionate here but means the password is the whole defence.
# Rotating ADMIN_SECRET instantly invalidates every signed-in session - it is
# the panic button if a link or laptop goes astray.
ADMIN_SECRET=
ADMIN_PASSWORD=

# --- Public origin --------------------------------------------------------
# The origin the site is served from, with no trailing slash, e.g.
#   https://our-wedding.vercel.app
#
# The admin builds copyable invite links from this. Without it the links render
# with no origin at all, which is not obvious until you paste one into WhatsApp
# and it goes nowhere. Vercel does not set this for you.
SITE_URL=

# --- Token hashing --------------------------------------------------------
# Salt for hashing IP addresses in the rate-limit table, so raw addresses are
# never stored at rest.
IP_SALT=

# --- Email (entirely optional) --------------------------------------------
# With EMAIL_PROVIDER unset, replies are still saved and the notification is
# written to the server log. Email is a nice-to-have, never a dependency:
# the RSVP is always persisted BEFORE any send is attempted.
#
# EMAIL_PROVIDER=resend | postmark
EMAIL_PROVIDER=
RESEND_API_KEY=
POSTMARK_TOKEN=
EMAIL_FROM=
OWNER_EMAIL=
