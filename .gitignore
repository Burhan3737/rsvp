# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files. NEVER commit a real one — .env.local holds ADMIN_SECRET, ADMIN_PASSWORD and IP_SALT.
# The example is placeholders only and is referenced by the README, so it is explicitly re-included.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local data & artefacts
.data/
screenshots/
test-results/
playwright-report/
.env.local

# scratch
*.tmp.mjs
*.tmp.txt
